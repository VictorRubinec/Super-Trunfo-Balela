{
  "version": 2,
  "functions": {
    "server.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/server.js"
    },
    {
      "source": "/recrutamento",
      "destination": "/recrutamento.html"
    },
    {
      "source": "/gerador",
      "destination": "/gerador.html"
    }
  ]
}
